MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 0da478c7d57c43f4c91b6c1e5baf1543, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 177823756288
    m_Localized: "Sei gegr\xFC\xDFt. Ich h\xE4tte nicht erwartet, hier noch jemanden
      zu sehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2960647991296
    m_Localized: "Sag mal, wie hei\xDFt du?"
    m_Metadata:
      m_Items: []
  - m_Id: 4410803433472
    m_Localized: "{name}... Was f\xFCr ein sch\xF6ner Name! Freut mich, dich kennenzulernen!"
    m_Metadata:
      m_Items: []
  - m_Id: 11618219929600
    m_Localized: "Und mich nennt man den H\xFCter der Puzzles."
    m_Metadata:
      m_Items: []
  - m_Id: 12624647368704
    m_Localized: Ich bewahre die Erinnerungen und Geheimnisse dieser alten Welt.
    m_Metadata:
      m_Items: []
  - m_Id: 15480834174976
    m_Localized: Ich kann dir helfen, aus diesem Kerker zu entkommen.
    m_Metadata:
      m_Items: []
  - m_Id: 16427236929536
    m_Localized: Aber im Gegenzug brauche ich deine Hilfe.
    m_Metadata:
      m_Items: []
  - m_Id: 17288444981248
    m_Localized: "Die alten Bilder dieser Welt wurden in St\xFCcke zerbrochen."
    m_Metadata:
      m_Items: []
  - m_Id: 18046410240000
    m_Localized: "Ihre Fragmente sind \xFCberall in dieser Welt verstreut."
    m_Metadata:
      m_Items: []
  - m_Id: 19109204930560
    m_Localized: Finde sie und hilf mir, die Bilder zu restaurieren.
    m_Metadata:
      m_Items: []
  - m_Id: 20722602684416
    m_Localized: Nun, {name}, wollen wir unser Abenteuer beginnen?
    m_Metadata:
      m_Items: []
  - m_Id: 21686390829056
    m_Localized: Dann beginnen wir mit dem Training. Zuerst zeige ich dir,
    m_Metadata:
      m_Items: []
  - m_Id: 22338655432704
    m_Localized: wie du den Helden steuerst.
    m_Metadata:
      m_Items: []
  - m_Id: 26926158655488
    m_Localized: Namen eingeben...
    m_Metadata:
      m_Items: []
  - m_Id: 703882265047040
    m_Localized: Siehst du die Pfeile nach links und rechts? Damit kannst du den
      Helden bewegen.
    m_Metadata:
      m_Items: []
  - m_Id: 704368183554048
    m_Localized: "Probier es aus! Dr\xFCcke beide Pfeile."
    m_Metadata:
      m_Items: []
  - m_Id: 706481546539008
    m_Localized: Sehr gut! Jetzt sehen wir, was der Held noch kann.
    m_Metadata:
      m_Items: []
  - m_Id: 1041935340875776
    m_Localized: "Siehst du? Der Sprungknopf ist erschienen. Dr\xFCcke ihn, um zu
      springen."
    m_Metadata:
      m_Items: []
  - m_Id: 1043591512141824
    m_Localized: Ausgezeichnet! Jetzt kannst du springen!
    m_Metadata:
      m_Items: []
  - m_Id: 1070935161384960
    m_Localized: Jetzt lernen wir anzugreifen. Siehst du den Trittknopf?
    m_Metadata:
      m_Items: []
  - m_Id: 1071349684449280
    m_Localized: "Probier es aus! Dr\xFCcke ihn, um zu treten."
    m_Metadata:
      m_Items: []
  - m_Id: 1071494538932224
    m_Localized: Wunderbar! Jetzt kannst du dich verteidigen.
    m_Metadata:
      m_Items: []
  - m_Id: 1071949167931392
    m_Localized: "Sieht so aus, als w\xE4rst du bereit f\xFCr deine erste Pr\xFCfung."
    m_Metadata:
      m_Items: []
  - m_Id: 1076541117116416
    m_Localized: "Siehst du diese T\xFCr? Versuch, sie mit einem Tritt aufzubrechen."
    m_Metadata:
      m_Items: []
  - m_Id: 5437918942277632
    m_Localized: "Gro\xDFartig! Du hast es geschafft! Der Weg ist frei!"
    m_Metadata:
      m_Items: []
  - m_Id: 5455946715181056
    m_Localized: Siehst du die Steigleiter?
    m_Metadata:
      m_Items: []
  - m_Id: 5456094581174272
    m_Localized: Geh hin und halte dich an den Sprossen fest.
    m_Metadata:
      m_Items: []
  - m_Id: 6140589537964032
    m_Localized: Siehst du die Pfeile nach oben und unten?
    m_Metadata:
      m_Items: []
  - m_Id: 6144760567771136
    m_Localized: Versuch, hoch- und runterzuklettern.
    m_Metadata:
      m_Items: []
  - m_Id: 6145098473484288
    m_Localized: Super! Siehst du die Keule da oben?
    m_Metadata:
      m_Items: []
  - m_Id: 6145643238076416
    m_Localized: Kletter hoch und geh zu ihr.
    m_Metadata:
      m_Items: []
  - m_Id: 6178152562765824
    m_Localized: "Um hochzuspringen, dr\xFCcke Sprung + \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 6459245987835904
    m_Localized: Siehst du das Handsymbol?
    m_Metadata:
      m_Items: []
  - m_Id: 6459685689307136
    m_Localized: Tippe darauf, um die Keule aufzuheben.
    m_Metadata:
      m_Items: []
  - m_Id: 6482168182157312
    m_Localized: "Super! Jetzt kannst du k\xE4mpfen."
    m_Metadata:
      m_Items: []
  - m_Id: 6482850545086464
    m_Localized: Nicht nur mit Tritten, sondern auch mit Waffen!
    m_Metadata:
      m_Items: []
  - m_Id: 6483758796451840
    m_Localized: 'Denk dran: Jede Waffe hat eine begrenzte Haltbarkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 6484393642110976
    m_Localized: Behalte den roten Balken im Auge!
    m_Metadata:
      m_Items: []
  - m_Id: 6505529830486016
    m_Localized: Tippe jetzt im Inventar auf die Keule.
    m_Metadata:
      m_Items: []
  - m_Id: 6506721310617600
    m_Localized: Super! Deine Keule ist jetzt kampfbereit!
    m_Metadata:
      m_Items: []
  - m_Id: 6507115273203712
    m_Localized: "Mit diesem Knopf legst du deine Waffe zur\xFCck ins Inventar."
    m_Metadata:
      m_Items: []
  - m_Id: 6514608200167424
    m_Localized: "Versuch, sie zu dr\xFCcken!"
    m_Metadata:
      m_Items: []
  - m_Id: 6535238110883840
    m_Localized: "W\xE4hle jetzt die Keule erneut aus."
    m_Metadata:
      m_Items: []
  - m_Id: 6535849749458944
    m_Localized: Jetzt probier die Keule aus!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
