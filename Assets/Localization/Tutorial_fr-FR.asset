%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_fr-FR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr-FR
  m_SharedData: {fileID: 11400000, guid: 0da478c7d57c43f4c91b6c1e5baf1543, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 177823756288
    m_Localized: "Je te salue. Je ne m'attendais pas \xE0 voir quelqu'un d'autre
      ici."
    m_Metadata:
      m_Items: []
  - m_Id: 2960647991296
    m_Localized: Dis-moi, comment t'appelles-tu?
    m_Metadata:
      m_Items: []
  - m_Id: 4410803433472
    m_Localized: "{name}... Quel joli pr\xE9nom ! Ravi de faire ta connaissance !"
    m_Metadata:
      m_Items: []
  - m_Id: 11618219929600
    m_Localized: Et moi, on m'appelle le Gardien des Puzzles.
    m_Metadata:
      m_Items: []
  - m_Id: 12624647368704
    m_Localized: "Je garde la m\xE9moire et les secrets de ce monde ancien."
    m_Metadata:
      m_Items: []
  - m_Id: 15480834174976
    m_Localized: "Je peux t'aider \xE0 sortir de ce cachot."
    m_Metadata:
      m_Items: []
  - m_Id: 16427236929536
    m_Localized: "Mais en \xE9change, j'aurai besoin de ton aide."
    m_Metadata:
      m_Items: []
  - m_Id: 17288444981248
    m_Localized: "Les anciennes images de ce monde ont \xE9t\xE9 bris\xE9es en morceaux."
    m_Metadata:
      m_Items: []
  - m_Id: 18046410240000
    m_Localized: "Leurs fragments sont dispers\xE9s aux quatre coins de ce monde."
    m_Metadata:
      m_Items: []
  - m_Id: 19109204930560
    m_Localized: "Trouve-les et aide-moi \xE0 restaurer les images perdues."
    m_Metadata:
      m_Items: []
  - m_Id: 20722602684416
    m_Localized: Alors, {name}, on commence notre aventure ?
    m_Metadata:
      m_Items: []
  - m_Id: 21686390829056
    m_Localized: "Alors, commen\xE7ons par l'entra\xEEnement. D'abord, je vais te
      montrer"
    m_Metadata:
      m_Items: []
  - m_Id: 22338655432704
    m_Localized: "comment contr\xF4ler le h\xE9ros."
    m_Metadata:
      m_Items: []
  - m_Id: 26926158655488
    m_Localized: "Entrez votre nom\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 703882265047040
    m_Localized: "Tu vois les fl\xE8ches gauche et droite ? Elles te permettent de
      d\xE9placer le h\xE9ros."
    m_Metadata:
      m_Items: []
  - m_Id: 704368183554048
    m_Localized: "Essaie ! Appuie sur les deux fl\xE8ches."
    m_Metadata:
      m_Items: []
  - m_Id: 706481546539008
    m_Localized: "Tr\xE8s bien ! Voyons maintenant ce que le h\xE9ros sait faire
      d'autre."
    m_Metadata:
      m_Items: []
  - m_Id: 1041935340875776
    m_Localized: Tu vois ? Le bouton de saut est apparu. Appuie dessus pour sauter.
    m_Metadata:
      m_Items: []
  - m_Id: 1043591512141824
    m_Localized: Excellent ! Maintenant, tu sais sauter !
    m_Metadata:
      m_Items: []
  - m_Id: 1070935161384960
    m_Localized: "Maintenant, apprenons \xE0 attaquer. Tu vois le bouton de coup
      de pied ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1071349684449280
    m_Localized: Essaie ! Appuie dessus pour donner un coup de pied.
    m_Metadata:
      m_Items: []
  - m_Id: 1071494538932224
    m_Localized: "Formidable ! Maintenant, tu sais te d\xE9fendre."
    m_Metadata:
      m_Items: []
  - m_Id: 1071949167931392
    m_Localized: "On dirait que tu es pr\xEAt pour ton premier d\xE9fi."
    m_Metadata:
      m_Items: []
  - m_Id: 1076541117116416
    m_Localized: Tu vois cette porte ? Essaie de l'enfoncer d'un coup de pied.
    m_Metadata:
      m_Items: []
  - m_Id: 5437918942277632
    m_Localized: "Bravo ! Tu as r\xE9ussi ! Le passage est libre !"
    m_Metadata:
      m_Items: []
  - m_Id: 5455946715181056
    m_Localized: "Tu vois cette \xE9chelle murale ?"
    m_Metadata:
      m_Items: []
  - m_Id: 5456094581174272
    m_Localized: Approche-toi et agrippe-toi aux barreaux.
    m_Metadata:
      m_Items: []
  - m_Id: 6140589537964032
    m_Localized: "Tu vois les fl\xE8ches vers le haut et vers le bas ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6144760567771136
    m_Localized: Essaie de monter et de descendre.
    m_Metadata:
      m_Items: []
  - m_Id: 6145098473484288
    m_Localized: "Super ! Tu vois la massue l\xE0-haut ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6145643238076416
    m_Localized: "Grimpe et approche-toi d\u2019elle."
    m_Metadata:
      m_Items: []
  - m_Id: 6178152562765824
    m_Localized: "Pour sauter l\xE0-haut, appuie sur Saut + \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 6459245987835904
    m_Localized: "Tu vois l'ic\xF4ne de la main ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6459685689307136
    m_Localized: Appuie dessus pour ramasser la massue.
    m_Metadata:
      m_Items: []
  - m_Id: 6482168182157312
    m_Localized: Super ! Maintenant, tu peux combattre.
    m_Metadata:
      m_Items: []
  - m_Id: 6482850545086464
    m_Localized: Pas seulement avec tes pieds, mais aussi avec des armes !
    m_Metadata:
      m_Items: []
  - m_Id: 6483758796451840
    m_Localized: "Mais rappelle-toi : chaque arme a une durabilit\xE9 limit\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 6484393642110976
    m_Localized: Surveille la barre rouge !
    m_Metadata:
      m_Items: []
  - m_Id: 6505529830486016
    m_Localized: Maintenant, appuie sur la massue dans ton inventaire.
    m_Metadata:
      m_Items: []
  - m_Id: 6506721310617600
    m_Localized: "Super ! Ta massue est pr\xEAte au combat !"
    m_Metadata:
      m_Items: []
  - m_Id: 6507115273203712
    m_Localized: Ce bouton remet ton arme dans l'inventaire.
    m_Metadata:
      m_Items: []
  - m_Id: 6514608200167424
    m_Localized: Essaie d'appuyer dessus !
    m_Metadata:
      m_Items: []
  - m_Id: 6535238110883840
    m_Localized: "Maintenant, s\xE9lectionne \xE0 nouveau la massue."
    m_Metadata:
      m_Items: []
  - m_Id: 6535849749458944
    m_Localized: "Maintenant, essaie de t\u2019en servir !"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
