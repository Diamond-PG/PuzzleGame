MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 0da478c7d57c43f4c91b6c1e5baf1543, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 177823756288
    m_Localized: Greetings! I didn't expect to see anyone else here.
    m_Metadata:
      m_Items: []
  - m_Id: 2960647991296
    m_Localized: Tell me, what's your name?
    m_Metadata:
      m_Items: []
  - m_Id: 4410803433472
    m_Localized: '{name}... What a wonderful name! Nice to meet you!'
    m_Metadata:
      m_Items: []
  - m_Id: 11618219929600
    m_Localized: And they call me the Keeper of Puzzles.
    m_Metadata:
      m_Items: []
  - m_Id: 12624647368704
    m_Localized: I guard the memories and secrets of this ancient world.
    m_Metadata:
      m_Items: []
  - m_Id: 15480834174976
    m_Localized: I can help you escape from this dungeon.
    m_Metadata:
      m_Items: []
  - m_Id: 16427236929536
    m_Localized: But in return, I'll need your help.
    m_Metadata:
      m_Items: []
  - m_Id: 17288444981248
    m_Localized: The ancient pictures of this world were broken into pieces.
    m_Metadata:
      m_Items: []
  - m_Id: 18046410240000
    m_Localized: Their fragments are scattered throughout this world.
    m_Metadata:
      m_Items: []
  - m_Id: 19109204930560
    m_Localized: Find them and help me restore the lost pictures.
    m_Metadata:
      m_Items: []
  - m_Id: 20722602684416
    m_Localized: So, {name}, shall we begin our adventure?
    m_Metadata:
      m_Items: []
  - m_Id: 21686390829056
    m_Localized: Then let's begin with the tutorial. First, I'll show you
    m_Metadata:
      m_Items: []
  - m_Id: 22338655432704
    m_Localized: how to control the hero.
    m_Metadata:
      m_Items: []
  - m_Id: 26926158655488
    m_Localized: Enter your name...
    m_Metadata:
      m_Items: []
  - m_Id: 703882265047040
    m_Localized: See the left and right arrows? Use them to move the hero.
    m_Metadata:
      m_Items: []
  - m_Id: 704368183554048
    m_Localized: Give it a try! Press each one.
    m_Metadata:
      m_Items: []
  - m_Id: 706481546539008
    m_Localized: Great! Now let's see what else the hero can do.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
